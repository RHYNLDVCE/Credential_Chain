# ====================================================================
# MSU-TCTO Academic Credential Verification System (ERC-5192)
# Next.js Unified Full-Stack Portal Configuration
# ====================================================================

PORT=3000
NODE_ENV=development

# --------------------------------------------------------------------
# PostgreSQL Database (Prisma ORM)
# --------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academic_credentials?schema=public"

# --------------------------------------------------------------------
# Blockchain / EVM Layer-2 Configuration
# --------------------------------------------------------------------
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Default Anvil Account 1 (Assigned REGISTRAR_ROLE)
REGISTRAR_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Default Anvil Account 0 (Assigned DEFAULT_ADMIN_ROLE)
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --------------------------------------------------------------------
# Institutional Metadata
# --------------------------------------------------------------------
INSTITUTION_ID=MSU-TCTO
INSTITUTION_NAME=Mindanao State University - Tawi-Tawi College of Technology and Oceanography
DEPARTMENT_NAME=Department of Information Technology

# --------------------------------------------------------------------
# Authentication & Security
# --------------------------------------------------------------------
JWT_SECRET=msu-tcto-academic-credential-secret-2026-key
JWT_EXPIRES_IN=24h

# --------------------------------------------------------------------
# Decentralized Storage (IPFS)
# --------------------------------------------------------------------
IPFS_STORAGE_MODE=local
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_JWT=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# --------------------------------------------------------------------
# Public Verification Portal URL (used in QR codes)
# --------------------------------------------------------------------
VERIFICATION_PORTAL_URL=http://localhost:3000
